NEXT_PUBLIC_SUPABASE_URL=
# 当前 Supabase 推荐使用浏览器可用的 publishable key。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 旧项目也可继续使用 legacy anon key；两者填写一个即可。
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 安全默认值；仅在 Supabase 同时关闭 Confirm Email 的小范围测试环境改为 false。
NEXT_PUBLIC_REQUIRE_EMAIL_CONFIRMATION=true
# 仅供服务端账号删除接口使用。不得加 NEXT_PUBLIC_ 前缀或提交真实值。
SUPABASE_SERVICE_ROLE_KEY=
