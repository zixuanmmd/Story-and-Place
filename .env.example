NEXT_PUBLIC_SUPABASE_URL=
# 当前 Supabase 推荐使用浏览器可用的 publishable key。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 旧项目也可继续使用 legacy anon key；两者填写一个即可。
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 可选的公开构建标签；Vercel Production 默认优先使用 Git commit SHA。
NEXT_PUBLIC_APP_VERSION=
# 安全默认值；仅在 Supabase 同时关闭 Confirm Email 的小范围测试环境改为 false。
NEXT_PUBLIC_REQUIRE_EMAIL_CONFIRMATION=true
# 仅供服务端账号删除接口使用。不得加 NEXT_PUBLIC_ 前缀或提交真实值。
SUPABASE_SERVICE_ROLE_KEY=
# 服务端限流标识符的 HMAC 密钥；生产/Preview 分别生成至少 32 字节的随机值。
# 不得加 NEXT_PUBLIC_ 前缀，不得与 Supabase 密钥复用。
RATE_LIMIT_SECRET=
# 服务端媒体孤儿清理端点密钥；至少 32 字节，不能使用 NEXT_PUBLIC_ 前缀。
MEDIA_CLEANUP_SECRET=
CRON_SECRET=
